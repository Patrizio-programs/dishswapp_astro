---
// src/components/Hero.astro
// DishSwapp homepage hero — recreates the gradient mockup.
//
//   • Sage → cream → peach diagonal gradient (sampled from the mockup).
//   • Large peachy-pink circle decoration on the right, bleeding off-edge.
//   • Eyebrow "Open-source recipes" — JetBrains Mono, uppercase, tracked (§07).
//   • Headline "Collect, collaborate, cook." — Playfair Display (§15 tagline),
//     with "cook." as a pink italic accent.
//   • Single spice CTA "Start exploring" — the one spice element per page (§16 note 3).
//
// Uses Bootstrap utility classes (container, position-relative, overflow-hidden, btn)
// plus scoped brand styles. Depends on the brand tokens + fonts from BaseLayout.

interface Props {
  /** Eyebrow label above the headline. */
  eyebrow?: string;
  /** Headline text. Use the <em> inside to mark the pink italic accent. */
  title?: string;
  /** CTA button label. */
  ctaLabel?: string;
  /** CTA link target. */
  ctaHref?: string;
}

const {
  eyebrow = 'Open-source recipes',
  title = 'Collect, collaborate, cook.',
  ctaLabel = 'Start exploring',
  ctaHref = '/cuisines',
} = Astro.props;

// Split the title so the last word becomes the pink italic accent.
const words = title.trim().split(/\s+/);
const head = words.slice(0, -1).join(' ');
const accent = words[words.length - 1];
---

<section class="ds-hero position-relative overflow-hidden">
  <!-- Decorative peachy-pink circle — bleeds off the right edge -->
  <div class="ds-hero__circle" aria-hidden="true"></div>

  <div class="container position-relative">
    <div class="ds-hero__content">
      <p class="ds-hero__eyebrow">{eyebrow}</p>

      <h1 class="ds-hero__title">
        {head}<br />
        <em class="ds-hero__title-accent">{accent}</em>
      </h1>

      <a class="btn ds-hero__cta" href={ctaHref}>
        {ctaLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .ds-hero {
    /* Gradient stops sampled from the mockup.
       Brand pink (#F9B7A4) and spice (#E07A3B) come from tokens.css (§19). */
    --hero-sage: #9fa9a0;
    --hero-cream: #e5e3de;
    --hero-peach: #f2b7a4;
    --hero-pink: #f9b7a4;
    --hero-spice: #e07a3b;

    background: linear-gradient(
      115deg,
      var(--hero-sage) 0%,
      var(--hero-cream) 40%,
      var(--hero-peach) 100%
    );
    min-height: 560px;
    display: flex;
    align-items: center;
    padding: 5rem 0;
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* Decorative circle — large, peachy pink, bleeds off the right edge */
  .ds-hero__circle {
    position: absolute;
    top: 50%;
    right: -200px;
    transform: translateY(-50%);
    width: 540px;
    height: 540px;
    border-radius: 50%;
    background: var(--hero-pink);
    opacity: 0.92;
    pointer-events: none;
  }

  /* Text block — left-aligned, capped for readability */
  .ds-hero__content {
    max-width: 34rem;
    position: relative;
    z-index: 2;
  }

  /* Eyebrow — JetBrains Mono, uppercase, tracked (§07) */
  .ds-hero__eyebrow {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 1.25rem;
    text-shadow: 0 1px 2px rgba(44, 42, 40, 0.15);
  }

  /* Headline — Playfair Display 700, white (§07 / §15) */
  .ds-hero__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    color: #ffffff;
    margin: 0 0 2.25rem;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 8px rgba(44, 42, 40, 0.12);
  }

  /* "cook." — pink italic accent (mirrors the wordmark's pink "Swapp", §04) */
  .ds-hero__title-accent {
    font-style: italic;
    font-weight: 700;
    color: var(--hero-pink);
    text-shadow: 0 1px 6px rgba(44, 42, 40, 0.18);
  }

  /* CTA — spice orange, pill, the only spice element on the page (§16 note 3) */
  .ds-hero__cta {
    background-color: var(--hero-spice);
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.7rem 1.85rem;
    border-radius: 999px;
    border: none;
    box-shadow: 0 4px 12px rgba(44, 42, 40, 0.12);
    transition: background-color 0.2s ease, transform 0.15s ease,
      box-shadow 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }
  .ds-hero__cta:hover,
  .ds-hero__cta:focus {
    background-color: #c96a32;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(44, 42, 40, 0.18);
  }

  /* Tablet / mobile — shrink the circle and nudge it so text stays clear */
  @media (max-width: 991.98px) {
    .ds-hero {
      min-height: 480px;
      padding: 4rem 0;
    }
    .ds-hero__circle {
      width: 420px;
      height: 420px;
      right: -170px;
    }
  }

  /* Phone — circle retreats to the lower-right, becomes a soft accent */
  @media (max-width: 575.98px) {
    .ds-hero {
      min-height: 440px;
      padding: 3.25rem 0;
    }
    .ds-hero__circle {
      width: 320px;
      height: 320px;
      right: -150px;
      top: auto;
      bottom: -80px;
      transform: none;
      opacity: 0.75;
    }
  }
</style>
