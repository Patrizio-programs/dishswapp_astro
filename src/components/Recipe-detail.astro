---
import type { CollectionEntry } from "astro:content";

interface Props {
  recipe: CollectionEntry<"recipes">;
  author: CollectionEntry<"authors">;
  cuisines: CollectionEntry<"cuisines">[];
  coverImage: CollectionEntry<"mediaAssets">;
  heroImage?: CollectionEntry<"mediaAssets">;
}

const { recipe, author, cuisines, coverImage, heroImage } = Astro.props;
const data = recipe.data;
const hero = heroImage ?? coverImage;

const totalMin = data.totalTimeMinutes ?? (data.prepTimeMinutes + data.cookTimeMinutes);
const metaLine = [
  cuisines.map((c) => c.data.name).join(", "),
  `${totalMin} min`,
  `${data.servingUnit} ${data.servings}`,
].join(" · ");

function relativeTime(iso: string): string {
  const then = new Date(iso).getTime();
  const now = Date.now();
  const days = Math.floor((now - then) / 86_400_000);
  if (days === 0) return "updated today";
  if (days === 1) return "updated yesterday";
  if (days < 7) return `updated ${days} days ago`;
  if (days < 30) return `updated ${Math.floor(days / 7)} weeks ago`;
  return `updated ${Math.floor(days / 30)} months ago`;
}

const updatedText = data.updatedAt ? relativeTime(data.updatedAt.toISOString()) : "";
const byline = `by ${author.data.displayName} · ${updatedText} · ${data.ratingCount} cooks tried this`;

const tipStep = data.steps.find((s) => s.tip);
const pageTitle = `${data.title} — DishSwapp`;
---

<Fragment>
  <title>{pageTitle}</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  {/* Bootstrap 5.3 (Brand Book §19) */}
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

  {/* Brand fonts */}
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

  {/* Open Graph / social sharing */}
  <meta property="og:title" content={data.title} />
  <meta property="og:description" content={data.description} />
  <meta property="og:image" content={hero.data.src} />
  <meta property="og:type" content="article" />
  <meta name="twitter:card" content="summary_large_image" />

  {/* HERO — full-bleed image with gradient scrim + title overlay */}
  <header class="recipe-hero">
    <img src={hero.data.src} alt={hero.data.alt} class="hero-img" />
    <div class="hero-scrim"></div>
    <div class="hero-content">
      <div class="eyebrow-light">{metaLine}</div>
      <h1 class="hero-title">{data.title}</h1>
      <div class="hero-byline">{byline}</div>
    </div>
  </header>

  {/* MDX body content — the narrative paragraphs from the recipe MDX */}
  {recipe.body && (
    <section class="recipe-headnote">
      <div class="container">
        <slot />
      </div>
    </section>
  )}

  {/* BODY — two-column: Ingredients (left) + Method (right) */}
  <main class="recipe-body">
    <div class="container">
      <div class="row g-5">

        <section class="col-lg-5">
          <h2 class="section-eyebrow">Ingredients</h2>
          <ul class="ingredient-list">
            {data.ingredients.map((ing) => (
              <li class="ingredient-row" data-id={ing.id}>
                <label class="ingredient-label">
                  <input type="checkbox" class="ingredient-check" />
                  <span class="quantity">{ing.quantity}{ing.unit ? ` ${ing.unit}` : ""}</span>
                  <span class="name">{ing.name}{ing.note ? <em class="note">, {ing.note}</em> : null}</span>
                </label>
                {ing.swapSuggestions && ing.swapSuggestions.length > 0 && (
                  <details class="swaps">
                    <summary>swap suggestions</summary>
                    <ul>
                      {ing.swapSuggestions.map((swap) => (
                        <li>Try <strong>{swap.with}</strong>{swap.note ? ` — ${swap.note}` : ""}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </li>
            ))}
          </ul>

          {tipStep && tipStep.tip && (
            <aside class="tip-callout">
              <div class="tip-label">Tip</div>
              <p class="tip-text">{tipStep.tip}</p>
            </aside>
          )}
        </section>

        <section class="col-lg-7">
          <h2 class="section-eyebrow">Method</h2>
          <ol class="step-list">
            {data.steps.map((step, i) => (
              <li class="step-row">
                <span class="step-num">{i + 1}</span>
                <div class="step-body">
                  <p class="step-text">{step.instruction}</p>
                  {step.tip && (
                    <p class="step-tip-inline">{step.tip}</p>
                  )}
                  {step.timerSeconds && step.timerSeconds > 0 && (
                    <button
                      type="button"
                      class="timer-btn"
                      data-seconds={step.timerSeconds}
                      aria-label={`Start ${Math.floor(step.timerSeconds / 60)} minute timer`}
                    >
                      <i class="bi bi-clock"></i>
                      Start {Math.floor(step.timerSeconds / 60)}:{String(step.timerSeconds % 60).padStart(2, "0")} timer
                    </button>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>

      </div>
    </div>
  </main>

  {/* Nutrition block */}
  {data.nutrition && (
    <section class="nutrition-block">
      <div class="container">
        <h3>Nutrition <small>(per serving)</small></h3>
        <dl>
          {data.nutrition.calories != null && <div><dt>Calories</dt><dd>{data.nutrition.calories}</dd></div>}
          {data.nutrition.proteinG != null && <div><dt>Protein</dt><dd>{data.nutrition.proteinG}g</dd></div>}
          {data.nutrition.fatG != null && <div><dt>Fat</dt><dd>{data.nutrition.fatG}g</dd></div>}
          {data.nutrition.carbsG != null && <div><dt>Carbs</dt><dd>{data.nutrition.carbsG}g</dd></div>}
          {data.nutrition.fiberG != null && <div><dt>Fiber</dt><dd>{data.nutrition.fiberG}g</dd></div>}
          {data.nutrition.sugarG != null && <div><dt>Sugar</dt><dd>{data.nutrition.sugarG}g</dd></div>}
          {data.nutrition.sodiumMg != null && <div><dt>Sodium</dt><dd>{data.nutrition.sodiumMg}mg</dd></div>}
        </dl>
        <p class="source">Source: {data.nutrition.source}</p>
      </div>
    </section>
  )}

  <div class="sticky-spacer"></div>

  {/* STICKY BOTTOM BAR — dark teal, stats + Save / Start cooking */}
  <footer class="recipe-actions">
    <div class="container">
      <div class="d-flex align-items-center justify-content-between py-3">
        <div class="action-stats">
          {data.ratingCount} cooks tried this
          <span class="dot">·</span>
          {data.commentsCount} comments
          <span class="dot">·</span>
          {data.swapsCount} swaps
        </div>
        <div class="d-flex gap-2">
          <button type="button" class="btn-save" id="saveBtn">
            <i class="bi bi-bookmark"></i>
            <span class="save-label">Save</span>
          </button>
          <button type="button" class="btn-cook" id="cookBtn">
            Start cooking
            <i class="bi bi-arrow-right"></i>
          </button>
        </div>
      </div>
    </div>
  </footer>

  {/* Bootstrap JS bundle */}
  <script is:inline src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  {/* Page logic — is:inline so Astro emits it verbatim */}
  <script is:inline>
    (function () {
      'use strict';

      var saveBtn = document.getElementById('saveBtn');
      var slug = window.location.pathname.split('/').filter(Boolean).pop();
      var storageKey = 'dishswapp:saved:' + slug;

      function refreshSaveState() {
        var isSaved = localStorage.getItem(storageKey) === '1';
        saveBtn.classList.toggle('saved', isSaved);
        saveBtn.querySelector('.save-label').textContent = isSaved ? 'Saved' : 'Save';
      }
      refreshSaveState();

      saveBtn.addEventListener('click', function () {
        var isSaved = localStorage.getItem(storageKey) === '1';
        if (isSaved) {
          localStorage.removeItem(storageKey);
        } else {
          localStorage.setItem(storageKey, '1');
        }
        refreshSaveState();
      });

      var checks = document.querySelectorAll('.ingredient-check');
      var checkKey = 'dishswapp:checks:' + slug;

      function loadChecks() {
        try {
          var saved = JSON.parse(localStorage.getItem(checkKey) || '{}');
          checks.forEach(function (cb) {
            var id = cb.closest('.ingredient-row').getAttribute('data-id');
            cb.checked = !!saved[id];
            cb.closest('.ingredient-label').classList.toggle('checked', cb.checked);
          });
        } catch (e) {}
      }
      loadChecks();

      checks.forEach(function (cb) {
        cb.addEventListener('change', function () {
          var saved = {};
          try { saved = JSON.parse(localStorage.getItem(checkKey) || '{}'); } catch (e) {}
          checks.forEach(function (c) {
            var id = c.closest('.ingredient-row').getAttribute('data-id');
            saved[id] = c.checked;
            c.closest('.ingredient-label').classList.toggle('checked', c.checked);
          });
          localStorage.setItem(checkKey, JSON.stringify(saved));
        });
      });

      var timerBtns = document.querySelectorAll('.timer-btn');
      timerBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var seconds = parseInt(btn.getAttribute('data-seconds'), 10);
          startTimer(seconds, btn);
        });
      });

      var activeTimers = {};
      function startTimer(seconds, btn) {
        var remaining = seconds;
        btn.disabled = true;
        btn.classList.add('running');
        function tick() {
          if (remaining <= 0) {
            btn.disabled = false;
            btn.classList.remove('running');
            btn.innerHTML = '<i class="bi bi-check-lg"></i> Done!';
            if ('speechSynthesis' in window) {
              try { window.speechSynthesis.speak(new SpeechSynthesisUtterance('Timer done.')); } catch (e) {}
            }
            return;
          }
          var m = Math.floor(remaining / 60);
          var s = remaining % 60;
          btn.innerHTML = '<i class="bi bi-hourglass-split"></i> ' + m + ':' + (s < 10 ? '0' + s : s);
          remaining--;
        }
        tick();
        activeTimers[btn.getAttribute('data-seconds')] = setInterval(tick, 1000);
      }

      var cookBtn = document.getElementById('cookBtn');
      var firstStep = document.querySelector('.step-row');
      if (cookBtn && firstStep) {
        cookBtn.addEventListener('click', function () {
          firstStep.scrollIntoView({ behavior: 'smooth', block: 'center' });
          firstStep.classList.add('active');
          setTimeout(function () { firstStep.classList.remove('active'); }, 2000);
        });
      }
    })();
  </script>

  <style is:global>
    :root {
      --ds-teal:        #3D717C;
      --ds-teal-dark:   #2A535C;
      --ds-teal-light:  #5A8E97;
      --ds-teal-tint:   #E5EDEF;
      --ds-pink:        #F9B7A4;
      --ds-pink-soft:   #FCE6DD;
      --ds-spice:       #E07A3B;
      --ds-spice-soft:  #F6E0CB;
      --ds-cream:       #FBF7F1;
      --ds-oat:         #EFE5D4;
      --ds-ink:         #2C2A28;
      --ds-muted:       #6B6661;
      --ds-border:      #E5DDD0;

      --ds-font-serif:  'Playfair Display', Georgia, serif;
      --ds-font-sans:   'Inter', system-ui, sans-serif;
      --ds-font-mono:   'JetBrains Mono', ui-monospace, monospace;

      --ds-r-sm:   4px;
      --ds-r-md:   10px;
      --ds-r-lg:   18px;
      --ds-r-pill: 999px;

      --ds-shadow-sm: 0 1px 2px rgba(44,42,40,0.06);
      --ds-shadow-md: 0 4px 12px rgba(44,42,40,0.08);
      --ds-shadow-lg: 0 12px 32px rgba(44,42,40,0.12);

      --sticky-bar-h: 68px;
    }

    body {
      background: var(--ds-cream);
      color: var(--ds-ink);
      font-family: var(--ds-font-sans);
      font-size: 15px;
      line-height: 1.6;
      margin: 0;
      padding: 0;
    }

    .recipe-hero {
      position: relative;
      width: 100%;
      height: 60vh;
      min-height: 420px;
      max-height: 640px;
      overflow: hidden;
    }
    .hero-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(44,42,40,0.05) 0%,
        rgba(44,42,40,0.05) 40%,
        rgba(44,42,40,0.55) 75%,
        rgba(44,42,40,0.85) 100%
      );
    }
    .hero-content {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 32px 48px 40px;
      color: #fff;
      max-width: 920px;
    }
    .eyebrow-light {
      font-family: var(--ds-font-mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--ds-pink);
      margin-bottom: 10px;
      opacity: 0.95;
    }
    .hero-title {
      font-family: var(--ds-font-serif);
      font-size: clamp(36px, 5vw, 56px);
      font-weight: 700;
      line-height: 1.05;
      margin: 0 0 12px;
      color: #fff;
      letter-spacing: -0.5px;
    }
    .hero-byline {
      font-family: var(--ds-font-mono);
      font-size: 13px;
      font-weight: 400;
      color: rgba(255,255,255,0.85);
      letter-spacing: 0.2px;
    }

    .recipe-headnote {
      padding: 24px 0 8px;
      font-family: var(--ds-font-serif);
      font-size: 17px;
      line-height: 1.7;
      color: var(--ds-ink);
    }
    .recipe-headnote p { margin: 0 0 1rem; }

    .recipe-body { padding: 56px 0 32px; }
    .section-eyebrow {
      font-family: var(--ds-font-mono);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--ds-teal);
      margin: 0 0 24px;
      padding-bottom: 10px;
      border-bottom: 1px solid var(--ds-border);
    }

    .ingredient-list { list-style: none; padding: 0; margin: 0; }
    .ingredient-row { border-bottom: 1px dashed var(--ds-border); padding: 0; }
    .ingredient-row:first-child { border-top: 1px dashed var(--ds-border); }
    .ingredient-label {
      display: flex;
      align-items: baseline;
      gap: 14px;
      padding: 11px 4px;
      cursor: pointer;
      user-select: none;
      margin: 0;
      transition: color 0.15s;
    }
    .ingredient-check {
      flex: 0 0 auto;
      margin: 0 4px 0 0;
      width: 16px;
      height: 16px;
      accent-color: var(--ds-teal);
      cursor: pointer;
      align-self: center;
    }
    .quantity {
      flex: 0 0 88px;
      font-family: var(--ds-font-mono);
      font-size: 14px;
      font-weight: 500;
      color: var(--ds-teal-dark);
      font-feature-settings: 'tnum' 1;
      text-align: right;
    }
    .name { flex: 1 1 auto; font-size: 15px; color: var(--ds-ink); line-height: 1.5; }
    .name .note { color: var(--ds-muted); font-style: italic; font-weight: 400; font-size: 13px; }
    .ingredient-label.checked .name { text-decoration: line-through; color: var(--ds-muted); }
    .ingredient-label.checked .quantity { color: var(--ds-muted); }
    .swaps { margin-top: 6px; font-size: 0.85rem; }
    .swaps summary { cursor: pointer; color: var(--ds-spice); }
    .swaps ul { padding-left: 1rem; }

    .tip-callout {
      background: var(--ds-oat);
      border-left: 3px solid var(--ds-spice);
      border-radius: 0 var(--ds-r-md) var(--ds-r-md) 0;
      padding: 16px 18px;
      margin-top: 28px;
    }
    .tip-label {
      font-family: var(--ds-font-mono);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--ds-spice);
      margin-bottom: 6px;
    }
    .tip-text {
      font-family: var(--ds-font-serif);
      font-style: italic;
      font-size: 15px;
      line-height: 1.55;
      color: var(--ds-ink);
      margin: 0;
    }

    .step-list { list-style: none; padding: 0; margin: 0; counter-reset: step; }
    .step-row {
      display: flex;
      gap: 18px;
      padding: 18px 0;
      border-bottom: 1px solid var(--ds-border);
      transition: background 0.3s;
    }
    .step-row:first-child { padding-top: 0; }
    .step-row:last-child { border-bottom: none; }
    .step-row.active {
      background: var(--ds-teal-tint);
      border-radius: var(--ds-r-md);
      padding-left: 12px;
      padding-right: 12px;
    }
    .step-num {
      flex: 0 0 32px;
      width: 32px;
      height: 32px;
      background: var(--ds-teal);
      color: #fff;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-family: var(--ds-font-mono);
      font-size: 14px;
      font-weight: 700;
      line-height: 1;
      margin-top: 2px;
    }
    .step-body { flex: 1 1 auto; }
    .step-text { font-size: 16px; line-height: 1.6; color: var(--ds-ink); margin: 0 0 6px; }
    .step-tip-inline {
      font-family: var(--ds-font-serif);
      font-style: italic;
      font-size: 14px;
      color: var(--ds-muted);
      margin: 6px 0 0;
      padding-left: 12px;
      border-left: 2px solid var(--ds-spice);
    }
    .timer-btn {
      margin-top: 10px;
      background: var(--ds-teal-tint);
      border: 1px solid var(--ds-teal);
      color: var(--ds-teal-dark);
      font-family: var(--ds-font-mono);
      font-size: 12px;
      font-weight: 500;
      padding: 5px 12px;
      border-radius: var(--ds-r-pill);
      cursor: pointer;
      transition: background 0.15s;
    }
    .timer-btn:hover { background: var(--ds-teal); color: #fff; }
    .timer-btn.running { background: var(--ds-spice-soft); border-color: var(--ds-spice); color: var(--ds-spice); }
    .timer-btn:disabled { cursor: default; }

    .nutrition-block {
      margin: 2rem 0;
      padding: 1.5rem;
      background: var(--ds-teal-tint);
      border-radius: var(--ds-r-lg);
    }
    .nutrition-block h3 { margin: 0 0 1rem; font-family: var(--ds-font-serif); }
    .nutrition-block small { color: var(--ds-muted); font-weight: normal; }
    .nutrition-block dl {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 1rem;
      margin: 0;
    }
    .nutrition-block dt { font-size: 0.75rem; color: var(--ds-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .nutrition-block dd { margin: 0; font-size: 1.25rem; font-weight: bold; font-family: var(--ds-font-mono); color: var(--ds-teal-dark); }
    .nutrition-block .source {
      font-size: 0.75rem;
      color: var(--ds-muted);
      margin: 1rem 0 0;
      text-transform: capitalize;
    }

    .sticky-spacer { height: var(--sticky-bar-h); }
    .recipe-actions {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--ds-teal-dark);
      color: #fff;
      z-index: 1030;
      box-shadow: 0 -4px 16px rgba(44,42,40,0.12);
      border-top: 1px solid rgba(255,255,255,0.08);
    }
    .action-stats {
      font-family: var(--ds-font-mono);
      font-size: 13px;
      color: rgba(255,255,255,0.88);
      letter-spacing: 0.3px;
    }
    .action-stats .dot { margin: 0 8px; opacity: 0.5; }

    .btn-save {
      background: rgba(255,255,255,0.12);
      color: #fff;
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: var(--ds-r-pill);
      padding: 9px 18px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-save:hover { background: rgba(255,255,255,0.2); }
    .btn-save.saved { background: var(--ds-pink); color: var(--ds-ink); border-color: var(--ds-pink); }

    .btn-cook {
      background: var(--ds-spice);
      color: #fff;
      border: none;
      border-radius: var(--ds-r-pill);
      padding: 9px 24px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.15s, transform 0.15s, box-shadow 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-cook:hover {
      background: #C76A35;
      transform: translateY(-1px);
      box-shadow: var(--ds-shadow-md);
    }
    .btn-cook i { font-size: 14px; }

    @media (max-width: 991px) {
      .hero-content { padding: 24px 24px 28px; }
      .recipe-body  { padding: 40px 0 24px; }
      .ingredient-list { margin-bottom: 8px; }
    }
    @media (max-width: 575px) {
      .recipe-hero { height: 50vh; min-height: 320px; }
      .hero-content { padding: 20px 18px 22px; }
      .hero-title { font-size: 28px; }
      .eyebrow-light { font-size: 10px; letter-spacing: 2px; }
      .hero-byline { font-size: 11px; }
      .action-stats { font-size: 11px; flex: 1 1 auto; min-width: 0; }
      .action-stats .dot { margin: 0 4px; }
      .btn-save, .btn-cook { padding: 8px 14px; font-size: 13px; }
      .btn-cook { padding: 8px 18px; }
      .quantity { flex-basis: 64px; font-size: 13px; }
      .name     { font-size: 14px; }
      .step-text { font-size: 15px; }
      .step-num { width: 28px; height: 28px; font-size: 12px; flex-basis: 28px; }
    }
  </style>
</Fragment>