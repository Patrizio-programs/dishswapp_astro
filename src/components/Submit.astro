---
// src/pages/submit.astro
//
// Public recipe submission form. Auth-gated by middleware.
// Drop this file at src/pages/submit.astro in your Astro project — it becomes
// the /submit route. The author is set automatically from the signed-in
// user's username (see Chapter 17 of the DishSwapp Data Architecture PDF).
//
// ── AUTH ──────────────────────────────────────────────────────────
// Middleware (src/middleware.ts) is expected to populate Astro.locals.user
// with { username, isAuthed }. Swap the resolve_session_somehow() stub in
// the middleware for your actual auth system (Clerk, Auth.js, custom).
//
// Uncomment the auth gate below once your middleware is wired:
//
//   const { user } = Astro.locals;
//   if (!user?.isAuthed) {
//     return Astro.redirect("/sign-in?next=/submit");
//   }
//
// ── DATA ──────────────────────────────────────────────────────────
// In production, replace the hardcoded seed lists below with live data
// from your Astro content collections:
//
//   import { getCollection } from "astro:content";
//   const cuisines = (await getCollection("cuisines")).map(c => ({
//     slug: c.slug, name: c.data.name,
//   }));
//   const diets = (await getCollection("diets")).map(d => ({
//     slug: d.slug, name: d.data.name,
//   }));
//   const tags = (await getCollection("tags", ({ data }) => data.isCurated))
//     .map(t => ({ slug: t.slug, name: t.data.name }));
//
// The hardcoded seed values below match the worldwide cuisine catalog
// (Chapter 11) and the curated tag set (Chapter 12) so the form renders
// correctly out of the box.

interface TaxonomyOption { slug: string; name: string }

const cuisines: TaxonomyOption[] = [
  { slug: 'italian',          name: 'Italian' },
  { slug: 'mexican',          name: 'Mexican' },
  { slug: 'asian',            name: 'Asian' },
  { slug: 'french',           name: 'French' },
  { slug: 'indian-north',     name: 'Indian (North)' },
  { slug: 'thai',             name: 'Thai' },
  { slug: 'japanese',         name: 'Japanese' },
  { slug: 'chinese-cantonese',name: 'Chinese (Cantonese)' },
  { slug: 'chinese-sichuan',  name: 'Chinese (Sichuan)' },
  { slug: 'mediterranean',    name: 'Mediterranean' },
  { slug: 'greek',            name: 'Greek' },
  { slug: 'spanish',          name: 'Spanish' },
  { slug: 'korean',           name: 'Korean' },
  { slug: 'vietnamese',       name: 'Vietnamese' },
  { slug: 'tex-mex',          name: 'Tex-Mex' },
  { slug: 'cajun-creole',     name: 'Cajun / Creole' },
  { slug: 'southern-us',      name: 'Southern US' },
  { slug: 'american',         name: 'American' },
  { slug: 'brazilian',        name: 'Brazilian' },
  { slug: 'peruvian',         name: 'Peruvian' },
  { slug: 'argentinian',      name: 'Argentinian' },
  { slug: 'jamaican',         name: 'Jamaican' },
  { slug: 'ethiopian',        name: 'Ethiopian' },
  { slug: 'nigerian',         name: 'Nigerian' },
  { slug: 'lebanese',         name: 'Lebanese' },
  { slug: 'turkish',          name: 'Turkish' },
  { slug: 'israeli',          name: 'Israeli' },
  { slug: 'persian',          name: 'Persian' },
  { slug: 'moroccan',         name: 'Moroccan' },
  { slug: 'egyptian',         name: 'Egyptian' },
  { slug: 'indian-south',     name: 'Indian (South)' },
  { slug: 'nepalese',         name: 'Nepalese' },
  { slug: 'sri-lankan',       name: 'Sri Lankan' },
  { slug: 'indonesian',       name: 'Indonesian' },
  { slug: 'filipino',         name: 'Filipino' },
  { slug: 'malaysian',        name: 'Malaysian' },
  { slug: 'singaporean',      name: 'Singaporean' },
  { slug: 'burmese',          name: 'Burmese' },
  { slug: 'cambodian',        name: 'Cambodian' },
  { slug: 'hawaiian',         name: 'Hawaiian' },
  { slug: 'australian-modern',name: 'Australian modern' },
