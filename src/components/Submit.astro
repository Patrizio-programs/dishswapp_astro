const mealTypes: TaxonomyOption[] = [
  { slug: 'breakfast', name: 'Breakfast' },
  { slug: 'lunch',     name: 'Lunch' },
  { slug: 'dinner',    name: 'Dinner' },
  { slug: 'snack',     name: 'Snack' },
  { slug: 'dessert',   name: 'Dessert' },
  { slug: 'drink',     name: 'Drink' },
];

const diets: TaxonomyOption[] = [
  { slug: 'vegan',        name: 'Vegan' },
  { slug: 'vegetarian',   name: 'Vegetarian' },
  { slug: 'gluten-free',  name: 'Gluten-Free' },
  { slug: 'keto',         name: 'Keto' },
  { slug: 'halal',        name: 'Halal' },
  { slug: 'kosher',       name: 'Kosher' },
  { slug: 'paleo',        name: 'Paleo' },
  { slug: 'low-fodmap',   name: 'Low-FODMAP' },
];

const seasons: TaxonomyOption[] = [
  { slug: 'spring', name: 'Spring' },
  { slug: 'summer', name: 'Summer' },
  { slug: 'fall',   name: 'Fall' },
  { slug: 'winter', name: 'Winter' },
  { slug: 'holiday',name: 'Holiday' },
];

const tags: TaxonomyOption[] = [
  { slug: 'one-pot',            name: 'One-Pot' },
  { slug: 'slow-cook',          name: 'Slow-Cook' },
  { slug: 'no-bake',            name: 'No-Bake' },
  { slug: 'grill',              name: 'Grill' },
  { slug: 'braise',             name: 'Braise' },
  { slug: 'cast-iron',          name: 'Cast-Iron' },
  { slug: 'instant-pot',        name: 'Instant Pot' },
  { slug: 'dutch-oven',         name: 'Dutch Oven' },
  { slug: 'weeknight',          name: 'Weeknight' },
  { slug: 'holiday',            name: 'Holiday' },
  { slug: 'dinner-party',       name: 'Dinner Party' },
  { slug: 'meal-prep',          name: 'Meal Prep' },
  { slug: 'high-protein',       name: 'High-Protein' },
  { slug: 'egg-free',           name: 'Egg-Free' },
  { slug: 'under-30-min',       name: 'Under 30 Min' },
  { slug: 'under-15-min',       name: 'Under 15 Min' },
  { slug: 'comfort-food',       name: 'Comfort Food' },
  { slug: 'light',              name: 'Light' },
  { slug: 'spicy',              name: 'Spicy' },
  { slug: 'kid-friendly',       name: 'Kid-Friendly' },
