import { Show } from '@clerk/astro/components';
---

<Show when="signed-in">
  <form id="recipe-form" style="display: grid; gap: 14px;">
    <h1>Add a recipe</h1>
    <p style="color: #6b7280; margin: 0;">
      Your name will be attached automatically. A maintainer reviews before it goes live.
    </p>

    <label style="display: grid; gap: 4px;">
      <span>Title *</span>
      <input name="title" required maxlength="80" placeholder="Grandma's Sunday ragù" />
    </label>

    <label style="display: grid; gap: 4px;">
      <span>Headnote * (max 280 chars)</span>
      <textarea name="description" required maxlength="280" rows="3"
        placeholder="A short intro — what it is, where it's from."></textarea>
    </label>

    <label style="display: grid; gap: 4px;">
      <span>Cuisine *</span>
      <select name="cuisines" required>
        <option value="italian">Italian</option>
        <option value="mexican">Mexican</option>
        <option value="french">French</option>
        <option value="asian">Asian</option>
        <option value="american">American</option>
        <option value="mediterranean">Mediterranean</option>
        <option value="other">Other</option>

      </select>
    </label>

    <fieldset style="border: 1px solid #e5e7eb; padding: 12px; border-radius: 6px;">
      <legend>Difficulty *</legend>
      <label style="margin-right: 12px;">
        <input type="radio" name="difficulty" value="easy" required /> Easy
      </label>
      <label style="margin-right: 12px;">
        <input type="radio" name="difficulty" value="intermediate" /> Intermediate
      </label>
      <label>
        <input type="radio" name="difficulty" value="advanced" /> Advanced
      </label>
    </fieldset>

    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
      <label style="display: grid; gap: 4px;">
        <span>Prep (min) *</span>
        <input name="prepTimeMinutes" type="number" min="0" required />
      </label>
      <label style="display: grid; gap: 4px;">
        <span>Cook (min) *</span>
        <input name="cookTimeMinutes" type="number" min="0" required />
      </label>
      <label style="display: grid; gap: 4px;">
        <span>Servings *</span>
        <input name="servings" type="number" min="1" value="4" required />
      </label>
    </div>

    <label style="display: grid; gap: 4px;">
      <span>Ingredients * (one per line)</span>
      <textarea name="ingredients" required rows="5"
        placeholder="400g beef chuck, finely diced&#10;1 onion, finely diced&#10;2 carrots&#10;120ml whole milk"></textarea>
    </label>

    <label style="display: grid; gap: 4px;">
      <span>Steps * (one per line)</span>
      <textarea name="steps" required rows="5"
        placeholder="Sweat the soffritto in olive oil until translucent.&#10;Brown the meat on all sides.&#10;Pour in the milk and reduce."></textarea>
    </label>

    <button type="submit"
      style="padding: 10px 18px; background: #0f766e; color: white; border: 0; border-radius: 6px; cursor: pointer;">
      Submit for review
    </button>

    <p id="form-status" role="status" style="margin: 0;"></p>
  </form>
</Show>

<Show when="signed-out">
  <p>Please <a href="/login">sign in</a> to submit a recipe.</p>
</Show>

<script>
  const form = document.getElementById('recipe-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status) return;
      status.textContent = 'Saving…';
      status.style.color = '#6b7280';

      const fd = new FormData(form);

      // Split the two textareas into the array shape Tina expects.
      const ingredients = (fd.get('ingredients') as string)
        .split('\n').map(s => s.trim()).filter(Boolean)
        .map((line, i) => ({ id: `ing-${i + 1}`, name: line }));

      const steps = (fd.get('steps') as string)
        .split('\n').map(s => s.trim()).filter(Boolean)
        .map((line, i) => ({ id: `step-${i + 1}`, instruction: line }));

      const payload = {
        title: fd.get('title'),
        description: fd.get('description'),
        cuisines: [fd.get('cuisines')],
        difficulty: fd.get('difficulty'),
        prepTimeMinutes: Number(fd.get('prepTimeMinutes')),
        cookTimeMinutes: Number(fd.get('cookTimeMinutes')),
        servings: Number(fd.get('servings')),
        ingredients,
        steps,
      };

      try {
        const res = await fetch('/api/recipes', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to save');
        status.style.color = '#0f766e';
        status.textContent = `Saved as a draft. Slug: ${data.slug}`;
        form.reset();
      } catch (err: any) {
        status.style.color = '#b91c1c';
        status.textContent = `Error: ${err.message}`;
      }
    });
  }
</script>