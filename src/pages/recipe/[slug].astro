---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layout/Layout.astro";
import RecipeDetail from "../../components/Recipe-detail.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro"; 


export const prerender = true;

export async function getStaticPaths() {
  const recipes = await getCollection("recipes", ({ data }) =>
    !data.isDraft && data.isPublic
  );
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);

const author = await getEntry(recipe.data.author);
const cuisines = await Promise.all(
  recipe.data.cuisines.map((c) => getEntry(c))
);
const coverImage = await getEntry(recipe.data.coverImage);
const heroImage = recipe.data.heroImage ? await getEntry(recipe.data.heroImage) : undefined;
---
<Layout title={recipe.data.title} description={recipe.data.description}>
  <Nav></Nav>
  <RecipeDetail
    recipe={recipe}
    author={author}
    cuisines={cuisines}
    coverImage={coverImage}
    heroImage={heroImage}
  >
    <Content />
  </RecipeDetail>

    <Footer></Footer>
</Layout>